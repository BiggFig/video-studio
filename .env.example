# Web application: Vercel + Neon + PRIVATE Vercel Blob
APP_URL=http://127.0.0.1:3000
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
SESSION_SECRET=
WORKER_SECRET=
CRON_SECRET=

# Single-use bootstrap invitation; use a random 32+ character token.
BETA_OWNER_EMAIL=
BETA_OWNER_NAME=Studio owner
BETA_OWNER_INVITE_TOKEN=

# Keep false until provider access and representative end-to-end checks pass.
BETA_ACCEPTING_JOBS=false
BETA_MAX_ACTIVE_JOBS=1
BETA_MAX_JOBS_PER_DAY=3
BETA_GLOBAL_CONCURRENCY=2
BETA_MAX_WORKER_SECONDS=1800
BETA_RETENTION_DAYS=30
BETA_MAX_FILES=12
BETA_MAX_FILE_BYTES=262144000
BETA_MAX_TOTAL_BYTES=524288000
BETA_MAX_PRD_BYTES=15728640
BETA_MAX_REFERENCE_BYTES=104857600
BETA_MAX_SOURCE_SECONDS=300
BETA_MAX_REFERENCE_SECONDS=180

# Claude: direct API key OR paid Vercel AI Gateway access.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.6
# Vercel OIDC authenticates Gateway and Sandbox automatically in deployment.
# Locally: vercel env pull .env.local (OIDC expires; pull again when necessary).
ELEVENLABS_API_KEY=

# Created by scripts/create-worker-snapshot.ts; use the same Vercel team.
WORKER_SNAPSHOT_ID=
