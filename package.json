{
  "name": "video-studio",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/bundle-worker.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts worker/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx db/migrate.ts",
    "worker": "tsx worker/index.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@vercel/blob": "2.8.0",
    "@vercel/sandbox": "3.5.1",
    "@vercel/functions": "3.9.9",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.49.0",
    "playwright": "1.63.0",
    "zod": "4.6.5",
    "server-only": "0.0.1",
    "hyperframes": "0.8.97",
    "gsap": "3.14.2"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.63.0"
  }
}
